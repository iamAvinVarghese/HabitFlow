<?xml version="1.0" encoding="utf-8"?>
<!--
    widget_medium.xml — 4×2 medium widget
    Shows: header with counts, up to 3 task rows, habit progress bar
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- App name + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_app_name_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HabitFlow"
                android:textColor="@color/widget_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_date_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Task count badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_pending_count_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" pending  "
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_habit_pct_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/widget_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" habits"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider" />

    <!-- ── Task rows (up to 3) ────────────────────────────────────────── -->

    <!-- Task row 1 -->
    <LinearLayout
        android:id="@+id/task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_row_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/task_priority_dot_1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_button_background"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/task_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Task row 2 -->
    <LinearLayout
        android:id="@+id/task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_row_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/task_priority_dot_2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_button_background"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/task_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Task row 3 -->
    <LinearLayout
        android:id="@+id/task_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/task_priority_dot_3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_button_background"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/task_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Empty state (shown when no tasks) -->
    <TextView
        android:id="@+id/tv_no_tasks_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_tasks"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="11sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Habit progress bar -->
    <ProgressBar
        android:id="@+id/progress_habits_medium"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/progress_track"
        android:indeterminate="false" />

    <!-- Habit label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_habits_done_medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0/0 habits"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_streak_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 day streak"
            android:textColor="@color/widget_accent"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
